[submodule "lib/zephyr-workspace/zephyr"]
	path = lib/zephyr-workspace/zephyr
	url = https://github.com/zephyrproject-rtos/zephyr.git
[submodule "lib/fprime"]
	path = lib/fprime
	url = https://github.com/JPL-Devin/fprime.git
	branch = devin/1792182121-ipcfg-socket-headers-on-devel
[submodule "lib/fprime-zephyr"]
	path = lib/fprime-zephyr
	url = https://github.com/fprime-community/fprime-zephyr.git
	branch = ota-with-patch
[submodule "lib/fprime-stress"]
	path = lib/fprime-stress
	url = https://github.com/LeStarch/fprime-stress.git
[submodule "lib/fprime-python"]
	path = lib/fprime-python
	url = https://github.com/fprime-community/fprime-python.git
