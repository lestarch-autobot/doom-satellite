/*
 * PJRC Teensy 4.1 for DoomFlight
 *
 * - USB CDC ACM is the console and the F Prime downlink/uplink (Zephyr.ZephyrUartDriver) and touch reset UART
 * - Native ENET Ethernet (PJRC Ethernet kit) is enabled by the board devicetree
 * - APS6404L PSRAM soldered on the bottom PSRAM pads (CS0), memory mapped by FlexSPI2 at 0x70000000
 * - The second FlexSPI2 pad (CS1) is unpopulated (READ_ID answers zeros); the DOOM WAD lives in a LittleFS partition
 *   in the upper 6.75 MB of the 8 MB W25Q64 program flash, which the XIP-safe FlexSPI NOR driver programs from ITCM
 */

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/ {
	chosen {
		zephyr,code-partition = &slot0_partition;
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
		/* F Prime ground link: XBee on Serial3 with RTS/CTS (Main.cpp falls back to CDC ACM without it) */
		doom,ground-uart = &lpuart2;
		zephyr,sram = &sram;
	};

	/* OCRAM2 (512 KB at 0x20200000) and FlexRAM OCRAM (256 KB at 0x20280000, fuse default bank split) are
	 * contiguous, so Zephyr uses them as one 768 KB RAM region for data, stacks and the malloc heap.
	 */
	sram: memory@20200000 {
		compatible = "mmio-sram";
		reg = <0x20200000 DT_SIZE_K(768)>;
	};

	/* PSRAM linker region: DoomFlight/PsramHeap.c carves its heap from it and DoomFlight/psram_sections.ld links the
	 * DoomEngine instance into it. Available once FlexSPI2 is up (POST_KERNEL, CONFIG_MEMC_INIT_PRIORITY).
	 */
	psram: memory@70000000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x70000000 DT_SIZE_M(8)>;
		zephyr,memory-region = "PSRAM";
	};

	fstab {
		compatible = "zephyr,fstab";

		/* WAD filesystem, formatted on first mount. Os::File opens paths under /lfs through the Zephyr fs API */
		lfs: lfs {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/lfs";
			partition = <&wad_partition>;
			automount;
			read-size = <16>;
			prog-size = <16>;
			cache-size = <256>;
			lookahead-size = <32>;
			block-cycles = <512>;
		};
	};
};

&pinctrl {
	/* Teensy 4.1 PSRAM pads: GPIO_EMC_22 (CS1), 23 (DQS), 24 (CS0), 25 (SCLK), 26-29 (DATA0-3) */
	pinmux_flexspi2: pinmux_flexspi2 {
		group0 {
			pinmux = <&iomuxc_gpio_emc_23_flexspi2_a_dqs>;
			drive-strength = "r0-6";
			input-schmitt-enable;
			slew-rate = "fast";
			nxp,speed = "200-mhz";
			input-enable;
		};

		group1 {
			pinmux = <&iomuxc_gpio_emc_22_flexspi2_a_ss1_b>,
				 <&iomuxc_gpio_emc_24_flexspi2_a_ss0_b>;
			drive-strength = "r0-6";
			slew-rate = "fast";
			nxp,speed = "200-mhz";
			bias-pull-up;
			bias-pull-up-value = "100k";
			input-schmitt-enable;
			input-enable;
		};

		group2 {
			pinmux = <&iomuxc_gpio_emc_25_flexspi2_a_sclk>;
			drive-strength = "r0-6";
			slew-rate = "fast";
			nxp,speed = "200-mhz";
			input-schmitt-enable;
			input-enable;
		};

		group3 {
			pinmux = <&iomuxc_gpio_emc_26_flexspi2_a_data0>,
				 <&iomuxc_gpio_emc_27_flexspi2_a_data1>,
				 <&iomuxc_gpio_emc_28_flexspi2_a_data2>,
				 <&iomuxc_gpio_emc_29_flexspi2_a_data3>;
			drive-strength = "r0-6";
			slew-rate = "fast";
			nxp,speed = "200-mhz";
			bias-pull-up;
			bias-pull-up-value = "47k";
			input-schmitt-enable;
			input-enable;
		};
	};
};

&flexspi2 {
	status = "okay";
	reg = <0x402a4000 0x4000>, <0x70000000 DT_SIZE_M(16)>;
	pinctrl-0 = <&pinmux_flexspi2>;
	pinctrl-names = "default";
	rx-clock-source = <1>;

	/* First chip (small pads, CS0): required */
	aps6404l0: aps6404l@0 {
		compatible = "nxp,imx-flexspi-aps6404l";
		/* APS6404L is 8MB, 64MBit pSRAM */
		size = <DT_SIZE_M(8 * 8)>;
		reg = <0>;
		/* FlexSPI2 root clock is PLL3 PFD0 / 8 = 90 MHz and the memc driver only divides it by an integer,
		 * rounding down: 88 MHz would select /2 = 45 MHz on the bus. 90 MHz runs the APS6404L (133 MHz part)
		 * at the full root clock with SERCLKDIV = /1.
		 */
		spi-max-frequency = <DT_FREQ_M(120)>;
		status = "okay";
		cs-interval-unit = <1>;
		cs-interval = <2>;
		cs-hold-time = <3>;
		cs-setup-time = <3>;
		data-valid-time = <6>;
		column-space = <0>;
		ahb-write-wait-unit = <2>;
		ahb-write-wait-interval = <0>;
	};
};

/* Program flash: the firmware is linked into the first 1 MB (zephyr,code-partition; the image is ~0.7 MB) so it can
 * never grow into the WAD filesystem partition. That partition takes the rest of the range teensy_loader_cli programs
 * on a Teensy 4.1 (0x000000..0x7C0000; it rejects HEX records at or above 0x7C0000, so the top 256 KB is unusable), i.e.
 * 6912 KiB: the shareware doom1.wad (4 MB) plus ~2.7 MB for WADs uploaded over fileUplink. A pre-built LittleFS image
 * (doom-satellite-merge-wad, tools/doom-satellite-tools) is flashed together with the firmware.
 */
&w25q64jvxgim {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		slot0_partition: partition@0 {
			label = "image-0";
			reg = <0x00000000 DT_SIZE_K(1024)>;
		};

		wad_partition: partition@100000 {
			label = "wad";
			reg = <0x00100000 DT_SIZE_K(6912)>;
		};
	};
};

/* Covered by the combined sram node */
&ocram {
	compatible = "mmio-sram";
	/delete-property/ zephyr,memory-region;
};

&ocram2 {
	compatible = "mmio-sram";
	/delete-property/ zephyr,memory-region;
};

/* XBee on Serial3 (LPUART2): TX pin 14, RX pin 15, CTS pin 19 (AD_B1_00), RTS pin 18 (AD_B1_01) */
&pinctrl {
	pinmux_lpuart2_flow: pinmux_lpuart2_flow {
		group0 {
			pinmux = <&iomuxc_gpio_ad_b1_03_lpuart2_rx>,
				 <&iomuxc_gpio_ad_b1_02_lpuart2_tx>,
				 <&iomuxc_gpio_ad_b1_00_lpuart2_cts_b>,
				 <&iomuxc_gpio_ad_b1_01_lpuart2_rts_b>;
			drive-strength = "r0-6";
			slew-rate = "slow";
			nxp,speed = "100-mhz";
		};
	};
};

&lpuart2 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_lpuart2>;
	pinctrl-1 = <&pinmux_lpuart2_flow>;
	pinctrl-2 = <&pinmux_lpuart2_sleep>;
	/* "flowcontrol" must precede "sleep" or the pinctrl state table does not compile */
	pinctrl-names = "default", "flowcontrol", "sleep";
};
